diff --git a/config.inc b/config.inc
index 8cae33c..232761d 100644
--- a/config.inc
+++ b/config.inc
@@ -13,8 +13,8 @@ config_inc = 1
 ; the Berkeley Softworks GEOS 64 2.0 variant
 ;------------------------
 .ifdef bsw
-	; BSW traps to counter tampering
-	traps = 1
+	; geoWrite autonome : pieges anti-modification desactives
+	;traps = 1
