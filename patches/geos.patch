diff --git a/drv/drv1541.s b/drv/drv1541.s
index b26cd8f..a88d000 100644
--- a/drv/drv1541.s
+++ b/drv/drv1541.s
@@ -253,6 +253,27 @@ _GetNxtDirEntry:
 	ldy #$ff
 	MoveW diskBlkBuf, r1
 	bne GNDirEntry0
+.ifdef bsw
+	; apres le vrai repertoire et le bloc frontiere : repertoire de la cartouche
+	lda borderFlag
+	beq @border
+	cmp #$ff
+	bne GNDirEntry1
+@rom:	lda #$fe
+	sta borderFlag
+	lda #ROM_TRACK
+	sta r1L
+	lda #0
+	sta r1H
+	beq GNDirEntry0
+@border:
+	lda #$ff
+	sta borderFlag
+	jsr GetBorder
+	bnex GNDirEntry1
+	tya
+	bne @rom
+.else
 	lda borderFlag
 	bne GNDirEntry1
 	lda #$ff
@@ -261,6 +282,7 @@ _GetNxtDirEntry:
 	bnex GNDirEntry1
 	tya
 	bne GNDirEntry1
+.endif
 GNDirEntry0:
 	jsr ReadBuff
 	ldy #0
@@ -1024,8 +1046,21 @@ ChngDskDv0:
 	pla
 	rts
 
+.ifdef bsw
+; geoWrite sur cartouche : la piste virtuelle 36 est lue depuis la ROM.
+ROM_TRACK = 36
+ROMRead = $0340
+.endif
+
 __ReadBlock:
 _ReadLink:
+.ifdef bsw
+	lda r1L
+	cmp #ROM_TRACK
+	bne @disk
+	jmp ROMRead
+@disk:
+.endif
 	jsr CheckParams_1
 	bcc RdBlock2
 	bbrf 6, curType, RdBlock0
